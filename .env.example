# Local-only example values. Never reuse these credentials outside a disposable environment.
SHAMBA_SIGNAL_ENV=local
SHAMBA_SIGNAL_HOST=127.0.0.1
SHAMBA_SIGNAL_PORT=8000
SHAMBA_SIGNAL_LOG_LEVEL=INFO
SHAMBA_SIGNAL_DATABASE_URL=postgresql://shamba_dev:local-only@localhost:5432/shamba_signal
SHAMBA_SIGNAL_OBJECT_STORE_URL=http://localhost:9000
SHAMBA_SIGNAL_OBJECT_STORE_BUCKET=shamba-signal-dev
